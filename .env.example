# Millennial Mum — environment
# Copy to .env and fill in your values. Two hosting paths are supported.

# ── Monolith (original Copilot SDK host: server.py) ──────────────────────────
# GitHub token with Copilot scope (only needed for the original monolith).
GITHUB_TOKEN=your_github_token_here

# ── Decomposed system (Agent Framework on Foundry: server_af.py / agents/app.py)
# Foundry project endpoint (Overview → project endpoint).
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry>.services.ai.azure.com/api/projects/<project>

# Application Insights (from the resource linked to the Foundry project) — enables
# OpenTelemetry tracing + per-agent cost views. Leave unset to run without tracing.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Per-agent Foundry DEPLOYMENT names (deployments are named by ROLE, not model,
# so cost is attributed per agent). Defaults below match the provisioned slate;
# override to point a role at a different deployment (e.g. a Claude deployment
# on a paid subscription).
MM_TRIAGE_MODEL=triage
MM_KITCHEN_MODEL=kitchen
MM_PLANNER_MODEL=planner
MM_ADMIN_BUDGET_MODEL=admin-budget
MM_HEALTH_MODEL=health
MM_MEMORY_MODEL=memory

# Set true to record prompt/response content on traces (off by default for
# family/health data).
MM_TRACE_SENSITIVE_DATA=false

# ── Latency: direct-specialist fast path ─────────────────────────────────────
# When a turn is confidently a single domain, stream that specialist straight to
# the parent instead of paying the orchestrator's routing + composition
# generations first. This is the main time-to-first-token lever. Set false for a
# like-for-like baseline run against the old orchestrated behaviour.
MM_FAST_PATH=true
# Domains that always keep full orchestration, comma-separated. Health is
# safety-critical (hardened NHS-only prompt, evaluated safety 1.0) and stays on
# the orchestrated path until the fast path has its own safety evaluation.
MM_FAST_PATH_EXCLUDE=health

# ── Durable storage for the JSON-backed tools (shopping list, family profile) ─
# Without these the tools fall back to a local file, which is fine for dev but
# is LOST between conversations on the hosted agent (ephemeral container disk).
# Point at a storage account and sign in with DefaultAzureCredential — the
# identity needs the "Storage Blob Data Contributor" role on the account.
MM_BLOB_ACCOUNT_URL=https://<your-storage-account>.blob.core.windows.net
# Container to hold the JSON documents (created automatically if missing).
MM_BLOB_CONTAINER=millennial-mum
# Optional blob-name prefix, e.g. "families/smith/" — the hook for per-family
# lists once the app is multi-tenant.
MM_BLOB_PREFIX=
# Local-only alternative to MM_BLOB_ACCOUNT_URL (e.g. Azurite).
MM_BLOB_CONNECTION_STRING=
# Directory for the local file fallback when no blob storage is configured.
MM_DATA_DIR=
