{
  "description": "Millennial Mum (decomposed) — Agent Framework triage orchestrator + domain specialists on Microsoft Foundry",
  "definition": {
    "kind": "hosted",
    "protocol_versions": [
      {
        "protocol": "responses",
        "version": "2025-03-01"
      }
    ],
    "cpu": "1",
    "memory": "2Gi",
    "environment_variables": {
      "FOUNDRY_PROJECT_ENDPOINT": "${FOUNDRY_PROJECT_ENDPOINT}",
      "APPLICATIONINSIGHTS_CONNECTION_STRING": "${APPLICATIONINSIGHTS_CONNECTION_STRING}",
      "MM_TRIAGE_MODEL": "triage",
      "MM_PLANNER_MODEL": "planner",
      "MM_KITCHEN_MODEL": "kitchen",
      "MM_MEMORY_MODEL": "memory",
      "MM_HEALTH_MODEL": "health",
      "MM_ADMIN_BUDGET_MODEL": "admin-budget"
    },
    "code_configuration": {
      "runtime": "python_3_13",
      "entry_point": ["python", "server_af.py"],
      "dependency_resolution": "remote_build"
    }
  }
}
